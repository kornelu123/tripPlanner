DATABASE_URL=postgresql://trip_planner:trip_planner@localhost:5432/trip_planner
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
WEBAUTHN_RP_ID=localhost
# Public browser key: restrict to the Maps JavaScript and Places APIs and to
# exact production/development HTTP referrer origins in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Never expose server credentials through NEXT_PUBLIC_. Restrict this key to
# each enabled server API and the production server's static egress IP.
GOOGLE_MAPS_SERVER_API_KEY=
